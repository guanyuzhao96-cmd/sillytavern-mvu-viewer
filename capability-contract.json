{
  "schemaVersion": 1,
  "minimum": {
    "sillytavern": null,
    "tavernHelper": null
  },
  "requirements": [
    {
      "id": "host-context",
      "owner": "sillytavern",
      "symbol": "scripts/st-context.js:getContext (native), SillyTavern.getContext (helper script fallback)",
      "required": true,
      "fallback": null
    },
    {
      "id": "host-events",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().eventSource",
      "required": false,
      "fallback": "Read live native generation state; subscriptions are refresh notifications"
    },
    {
      "id": "native-generation-state",
      "owner": "sillytavern",
      "symbol": "script.js:isGenerating",
      "required": false,
      "fallback": "script.js:is_send_press + group-chats.js:is_group_generating; unknown state refuses writes"
    },
    {
      "id": "message-read",
      "owner": "tavern-helper",
      "symbol": "TavernHelper.getChatMessages",
      "required": true,
      "fallback": null
    },
    {
      "id": "message-write",
      "owner": "tavern-helper",
      "symbol": "TavernHelper.updateVariablesWith",
      "required": true,
      "fallback": null
    },
    {
      "id": "mvu-read",
      "owner": "provider",
      "symbol": "Mvu.getMvuData",
      "required": true,
      "fallback": null
    },
    {
      "id": "cleanup-message-write",
      "owner": "tavern-helper",
      "symbol": "TavernHelper.setChatMessages",
      "required": false,
      "fallback": "Disable chat cleanup writing if unavailable"
    },
    {
      "id": "cleanup-settings",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().saveSettingsDebounced",
      "required": false,
      "fallback": "Report settings unavailable"
    },
    {
      "id": "worldbook-native",
      "owner": "sillytavern",
      "symbol": "world-info.js:updateWorldInfoList, world_names; script.js:getRequestHeaders; /api/worldinfo/get",
      "required": false,
      "fallback": "Worldbook page reports unsupported API; MVU and cleanup remain available"
    },
    {
      "id": "worldbook-delete",
      "owner": "sillytavern",
      "symbol": "TavernHelper.deleteWorldbook or world-info.js:deleteWorldInfo",
      "required": false,
      "fallback": "Deletion reports unsupported API and stops; export remains available"
    }
  ]
}
